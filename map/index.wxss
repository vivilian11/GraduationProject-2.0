.map-container { width: 100vw; height: 100vh; }
.main-map { width: 100%; height: 100%; }

/* 顶部提示 */
.map-header {
  position: absolute; top: 30rpx; left: 30rpx; right: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 20rpx; border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  text-align: center;
}
.header-text { font-size: 26rpx; color: #07c160; font-weight: bold; }

/* 底部卡片 */
.place-card {
  position: absolute; bottom: 50rpx; left: 30rpx; right: 30rpx;
  background: #ffffff; border-radius: 30rpx;
  padding: 40rpx; display: flex; align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
}

.place-info { flex: 1; }
.place-name { font-size: 34rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.place-addr { font-size: 24rpx; color: #999; }
.place-dist { font-size: 24rpx; color: #07c160; margin-top: 10rpx; display: flex; }
.dist-num { font-weight: bold; margin: 0 4rpx; }

/* 导航按钮 */
.nav-btn {
  background: #07c160; color: #fff;
  padding: 20rpx 30rpx; border-radius: 40rpx;
  display: flex; flex-direction: column; align-items: center;
  font-size: 22rpx;
}
.nav-icon { width: 36rpx; height: 36rpx; margin-bottom: 6rpx; }