<!--pages/admin/community-manage/community-manage.wxml-->
<view class="page">
  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab {{activeTab === 'posts' ? 'active' : ''}}" bindtap="switchTab" data-tab="posts">帖子列表</view>
    <view class="tab {{activeTab === 'comments' ? 'active' : ''}}" bindtap="switchTab" data-tab="comments">评论列表</view>
  </view>

  <!-- 状态筛选 -->
  <view class="status-filter">
    <view class="filter-btn {{statusFilter === -1 ? 'active' : ''}}" bindtap="switchStatusFilter" data-val="-1">全部</view>
    <view class="filter-btn pending {{statusFilter === 0 ? 'active' : ''}}" bindtap="switchStatusFilter" data-val="0">审核中</view>
    <view class="filter-btn approved {{statusFilter === 1 ? 'active' : ''}}" bindtap="switchStatusFilter" data-val="1">已通过</view>
    <view class="filter-btn rejected {{statusFilter === 2 ? 'active' : ''}}" bindtap="switchStatusFilter" data-val="2">已驳回</view>
  </view>

  <!-- 帖子列表 -->
  <view class="list" wx:if="{{activeTab === 'posts'}}">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view class="card-header">
        <text class="post-author">{{item.authorName || '匿名用户'}}</text>
        <view class="status-badge status-{{item.status}}">
          {{item.status === 0 ? '审核中' : item.status === 1 ? '已通过' : '已驳回'}}
        </view>
      </view>
      <text class="card-time">{{item.dateString || item.createTime}}</text>
      <text class="post-content">{{item.content}}</text>
      <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" class="post-img" mode="aspectFill"></image>
      <view class="card-footer">
        <text class="meta">👍 {{item.likeCount || 0}}</text>
        <view class="btn-group">
          <view wx:if="{{item.status !== 1}}" class="btn btn-approve" bindtap="approveItem" data-id="{{item._id}}" data-col="posts">通过</view>
          <view wx:if="{{item.status !== 2}}" class="btn btn-reject" bindtap="rejectItem" data-id="{{item._id}}" data-col="posts">驳回</view>
          <view class="btn btn-del" bindtap="confirmDelete" data-id="{{item._id}}" data-col="posts">删除</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && list.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无帖子</text>
    </view>
  </view>

  <!-- 评论列表 -->
  <view class="list" wx:if="{{activeTab === 'comments'}}">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view class="card-header">
        <text class="post-author">{{item.authorName || '匿名用户'}}</text>
        <view class="status-badge status-{{item.status}}">
          {{item.status === 0 ? '审核中' : item.status === 1 ? '已通过' : '已驳回'}}
        </view>
      </view>
      <text class="card-time">{{item.createTime}}</text>
      <text class="post-content">{{item.content}}</text>
      <view class="card-footer">
        <text class="meta">所属帖子: {{item.postId}}</text>
        <view class="btn-group">
          <view wx:if="{{item.status !== 1}}" class="btn btn-approve" bindtap="approveItem" data-id="{{item._id}}" data-col="comments">通过</view>
          <view wx:if="{{item.status !== 2}}" class="btn btn-reject" bindtap="rejectItem" data-id="{{item._id}}" data-col="comments">驳回</view>
          <view class="btn btn-del" bindtap="confirmDelete" data-id="{{item._id}}" data-col="comments">删除</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && list.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无评论</text>
    </view>
  </view>

  <!-- 分页 -->
  <view class="pagination" wx:if="{{list.length > 0}}">
    <view class="page-btn {{page === 0 ? 'disabled' : ''}}" bindtap="prevPage">上一页</view>
    <text class="page-info">第 {{page + 1}} 页</text>
    <view class="page-btn {{list.length < pageSize ? 'disabled' : ''}}" bindtap="nextPage">下一页</view>
  </view>
</view>
