/* pages/admin/appointment-manage/appointment-manage.wxss */
page { background: #f4f6f9; }

.filter-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  background: #f4f6f9;
}
.filter-item.active {
  background: #1a73e8;
  color: #fff;
  font-weight: bold;
}

.list { padding: 20rpx 24rpx 40rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.status-tag {
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}
.status-0 { background: #fff3e0; color: #f57c00; }
.status-1 { background: #e3f2fd; color: #1565c0; }
.status-2 { background: #e8f5e9; color: #2e7d32; }
.card-time { font-size: 22rpx; color: #bbb; }

.card-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.card-row:last-of-type { border-bottom: none; }
.label { font-size: 26rpx; color: #999; width: 140rpx; flex-shrink: 0; }
.value { font-size: 26rpx; color: #333; flex: 1; }

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: bold;
}
.btn-next { background: #1a73e8; color: #fff; }
.btn-del  { background: #fce8e6; color: #d93025; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 20rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #bbb; }

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0 60rpx;
  gap: 40rpx;
}
.page-btn {
  background: #1a73e8;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
}
.page-btn.disabled { background: #ccc; }
.page-info { font-size: 26rpx; color: #666; }
