/* pages/admin/user-manage/user-manage.wxss */
page { background: #f4f6f9; }

.search-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.search-input {
  background: #f4f6f9;
  border-radius: 20rpx;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.list { padding: 20rpx 24rpx 40rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 用户头部 */
.user-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.avatar {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}
.user-meta { flex: 1; }
.user-name-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 8rpx; }
.user-name { font-size: 32rpx; font-weight: bold; color: #1a1a1a; }
.admin-badge {
  background: #1a73e8;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.user-openid { font-size: 22rpx; color: #bbb; }
.user-points {
  display: flex; flex-direction: column; align-items: center;
  background: #fff8e1; border-radius: 16rpx; padding: 14rpx 20rpx;
}
.points-num { font-size: 36rpx; font-weight: bold; color: #f9a825; }
.points-label { font-size: 20rpx; color: #f9a825; }

/* 展开详情 */
.user-detail {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.detail-row { display: flex; justify-content: space-between; padding: 10rpx 0; }
.detail-label { font-size: 26rpx; color: #999; }
.detail-val { font-size: 26rpx; color: #333; }
.detail-section-title {
  font-size: 24rpx; font-weight: bold; color: #666;
  margin: 16rpx 0 10rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #eee;
}
.log-item {
  display: flex; justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.log-reason { font-size: 24rpx; color: #555; flex: 1; }
.log-points { font-size: 26rpx; font-weight: bold; }
.log-points.positive { color: #2e7d32; }
.log-points.negative { color: #d93025; }
.log-loading, .log-empty { font-size: 24rpx; color: #bbb; padding: 10rpx 0; }
.badge-item { display: flex; justify-content: space-between; padding: 10rpx 0; }
.badge-name { font-size: 26rpx; color: #444; }
.badge-time { font-size: 22rpx; color: #bbb; }

/* 操作按钮 */
.card-actions { display: flex; gap: 16rpx; }
.btn {
  flex: 1; text-align: center;
  padding: 16rpx 0; border-radius: 12rpx;
  font-size: 26rpx; font-weight: bold;
}
.btn-detail { background: #e8f0fe; color: #1a73e8; }
.btn-del    { background: #fce8e6; color: #d93025; }

.empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 0; gap: 20rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #bbb; }

.pagination {
  display: flex; justify-content: center; align-items: center;
  padding: 20rpx 0 60rpx; gap: 40rpx;
}
.page-btn { background: #1a73e8; color: #fff; padding: 16rpx 40rpx; border-radius: 14rpx; font-size: 26rpx; }
.page-btn.disabled { background: #ccc; }
.page-info { font-size: 26rpx; color: #666; }
