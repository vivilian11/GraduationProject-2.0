<!--pages/admin/user-manage/user-manage.wxml-->
<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索用户昵称..." bindinput="onSearch" value="{{keyword}}" />
  </view>

  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <!-- 用户基本信息 -->
      <view class="user-header">
        <image class="avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-meta">
          <view class="user-name-row">
            <text class="user-name">{{item.nickName || '未知用户'}}</text>
            <view class="admin-badge" wx:if="{{item.isAdmin}}">管理员</view>
          </view>
          <text class="user-openid">ID: {{item.displayId}}</text>
        </view>
        <view class="user-points">
          <text class="points-num">{{item.points || 0}}</text>
          <text class="points-label">积分</text>
        </view>
      </view>

      <!-- 展开详情 -->
      <view class="user-detail" wx:if="{{expandedId === item._id}}">
        <view class="detail-row">
          <text class="detail-label">最后更新</text>
          <text class="detail-val">{{item.displayTime}}</text>
        </view>
        <view class="detail-section-title">积分记录</view>
        <view wx:if="{{pointLogs[item._id] && pointLogs[item._id].length > 0}}">
          <view class="log-item" wx:for="{{pointLogs[item._id]}}" wx:key="_id" wx:for-item="log">
            <text class="log-reason">{{log.actionDesc || log.actionType || '--'}}</text>
            <text class="log-points {{log.pointsAdded > 0 ? 'positive' : 'negative'}}">
              {{log.pointsAdded > 0 ? '+' : ''}}{{log.pointsAdded}}
            </text>
          </view>
        </view>
        <view wx:elif="{{loadingLogs}}" class="log-loading">加载中...</view>
        <view wx:else class="log-empty">暂无积分记录</view>

        <view class="detail-section-title">获得徽章</view>
        <view wx:if="{{badges[item._id] && badges[item._id].length > 0}}">
          <view class="badge-item" wx:for="{{badges[item._id]}}" wx:key="_id" wx:for-item="b">
            <text class="badge-name">🏅 {{b.badgeName || b.badgeId}}</text>
            <text class="badge-time">{{b.createTime || ''}}</text>
          </view>
        </view>
        <view wx:else class="log-empty">暂无徽章记录</view>
      </view>

      <!-- 操作按钮 -->
      <view class="card-actions">
        <view class="btn btn-detail" bindtap="toggleDetail" data-id="{{item._id}}">
          {{expandedId === item._id ? '收起' : '查看详情'}}
        </view>
        <view class="btn btn-del" bindtap="confirmDelete" data-id="{{item._id}}">删除用户</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && list.length === 0}}">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无用户数据</text>
    </view>
  </view>

  <view class="pagination" wx:if="{{list.length > 0}}">
    <view class="page-btn {{page === 0 ? 'disabled' : ''}}" bindtap="prevPage">上一页</view>
    <text class="page-info">第 {{page + 1}} 页</text>
    <view class="page-btn {{list.length < pageSize ? 'disabled' : ''}}" bindtap="nextPage">下一页</view>
  </view>
</view>
