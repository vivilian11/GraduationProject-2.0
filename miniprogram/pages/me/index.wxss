page { background-color: #f7f8fa; }
.me-container { display: flex; flex-direction: column; }

/* 头部名片 */
.user-header {
  background: linear-gradient(180deg, #07C160 0%, #059a4d 100%);
  height: 380rpx;
  padding: 100rpx 40rpx 0;
  box-sizing: border-box;
}
.user-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
  position: relative;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #eee;
}
.user-info { margin-left: 30rpx; display: flex; flex-direction: column; }
.user-nickname { font-size: 36rpx; font-weight: bold; color: #333; }
.user-id { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.points-badge {
  position: absolute;
  right: 40rpx;
  text-align: center;
  background: #f0fdf4;
  padding: 15rpx 25rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e8f5e9;
}
.points-val { font-size: 36rpx; font-weight: bold; color: #07C160; display: block; }
.points-unit { font-size: 20rpx; color: #666; }

/* 列表菜单 */
.menu-list {
  margin: -40rpx 30rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 30rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.menu-item:last-child { border-bottom: none; }
.menu-left { display: flex; align-items: center; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { font-size: 30rpx; color: #333; }
.menu-arrow { color: #ccc; font-size: 24rpx; }

/* 修正Button默认样式 */
.btn-clear {
  width: 100% !important;
  background: none !important;
  font-weight: normal !important;
  line-height: normal !important;
}

/* 管理员入口 */
.admin-section {
  margin-top: 24rpx;
  border: 2rpx solid #ffe58f;
}
.admin-item {
  border-bottom: none !important;
}
.admin-text {
  color: #d48806 !important;
  font-weight: bold;
}