page { background: #fff; }
.container { padding: 30rpx; }

/* 顶部栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}
.cancel-btn { color: #666; font-size: 32rpx; }
.publish-btn {
  background: #07c160;
  color: white;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 40rpx;
  margin: 0;
}
.disabled { background: #eee !important; color: #ccc !important; }

/* 输入区 */
.content-input {
  width: 100%;
  height: 300rpx;
  font-size: 32rpx;
  line-height: 1.6;
}

/* 图片预览网格 */
.image-section { margin-top: 40rpx; }
.image-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.image-item, .add-image-btn {
  width: 210rpx;
  height: 210rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  position: relative;
}
.img { width: 100%; height: 100%; border-radius: 12rpx; }

.delete-icon {
  position: absolute; top: -10rpx; right: -10rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  text-align: center; line-height: 36rpx; font-size: 32rpx;
}

.add-image-btn {
  display: flex; justify-content: center; align-items: center;
  border: 2rpx dashed #ccc;
}
.plus { font-size: 60rpx; color: #ccc; }
.image-tip { font-size: 24rpx; color: #999; margin-top: 20rpx; display: block; }

.comment-section {
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 15rpx;
  margin-top: 20rpx;
}
.comment-item {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  line-height: 1.4;
}
.comment-user {
  color: #576b95; /* 类似朋友圈名字的蓝色 */
  font-weight: bold;
}
.comment-content {
  color: #333;
}