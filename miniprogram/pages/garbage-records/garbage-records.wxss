.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.record-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.record-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.garbage-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.type-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  width: fit-content;
}

/* 颜色区分  */
/* 对应有害垃圾 */
.tag-hazardous { 
  background-color: #ffebee !important; 
  color: #f44336 !important; 
}

/* 对应可回收物 */
.tag-recyclable { 
  background-color: #e3f2fd !important; 
  color: #2196f3 !important; 
}

/* 对应厨余垃圾 */
.tag-kitchen { 
  background-color: #e8f5e9 !important; 
  color: #4caf50 !important; 
}

/* 对应其他垃圾 */
.tag-other { 
  background-color: #f5f5f5 !important; 
  color: #9e9e9e !important; 
}

.record-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}