page { background-color: #f8f9fa; }
.container { padding-bottom: 60rpx; }

/* 积分卡片样式 */
.points-header {
  width: 100%;
  padding: 40rpx;
  background: linear-gradient(135deg, #07c160, #059a4d);
  box-sizing: border-box;
}
.points-card {
  background: rgba(255, 255, 255, 0.15);
  padding: 30rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
  color: white;
}
.points-label { font-size: 26rpx; opacity: 0.9; }
.points-value-row { margin-top: 10rpx; display: flex; align-items: baseline; }
.points-num { font-size: 64rpx; font-weight: bold; }
.points-unit { font-size: 28rpx; margin-left: 10rpx; }

/* 勋章墙布局 */
.badge-wall {
  width: 100%;
  background: white;
  margin-top: -20rpx;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 20rpx;
  box-sizing: border-box;
}
.wall-title-box { margin-bottom: 40rpx; padding-left: 20rpx; }
.wall-title { font-size: 36rpx; font-weight: bold; color: #333; display: block; }
.wall-subtitle { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}
.badge-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  transition: all 0.3s;
}

/* 核心：未解锁勋章变灰 */
.locked .badge-icon {
  filter: grayscale(100%);
  opacity: 0.3;
}
.badge-icon-wrap { position: relative; width: 140rpx; height: 140rpx; }
.badge-icon { width: 100%; height: 100%; }
.lock-icon {
  position: absolute;
  right: 0;
  bottom: 0;
  background: #666;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
}

.badge-name { font-size: 26rpx; font-weight: bold; color: #333; margin-top: 16rpx; }

.status-tag {
  font-size: 20rpx;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.tag-unlocked { color: #07c160; background: #e8f5e9; }
.tag-locked { color: #999; background: #f5f5f5; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6); z-index: 100;
}
.modal-content {
  position: fixed; bottom: -1000rpx; left: 0; right: 0;
  background: white; border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx; z-index: 101; transition: all 0.3s ease-out;
}
.modal-show { bottom: 0; }
.modal-header { display: flex; justify-content: space-between; font-weight: bold; font-size: 32rpx; margin-bottom: 40rpx; }
.modal-body { display: flex; flex-direction: column; align-items: center; }
.modal-badge-img { width: 200rpx; height: 200rpx; margin-bottom: 20rpx; }
.modal-badge-name { font-size: 34rpx; font-weight: bold; }
.modal-badge-desc { font-size: 26rpx; color: #888; text-align: center; margin: 20rpx 0; }
.modal-points-info { width: 100%; background: #f8f8f8; padding: 20rpx; border-radius: 16rpx; display: flex; justify-content: space-between; font-size: 28rpx; }
.cost-text { color: #fa5151; font-weight: bold; }
.modal-footer { margin-top: 40rpx; }
.btn-confirm { background: #07c160; color: white; border-radius: 50rpx; font-size: 32rpx; }
.btn-disabled { background: #ccc !important; }