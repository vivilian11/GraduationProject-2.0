page { background-color: #f8f9fa; }

.header-card {
  background: linear-gradient(135deg, #07c160, #059a4d);
  padding: 60rpx 40rpx;
  color: white;
}
.header-title { font-size: 40rpx; font-weight: bold; display: block; }
.header-subtitle { font-size: 24rpx; opacity: 0.8; margin-top: 10rpx; display: block; }

.history-list {
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.log-item {
  background: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.log-left { display: flex; flex-direction: column; }
.log-desc { font-size: 30rpx; color: #333; font-weight: 500; }
.log-date { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.points-tag { font-size: 36rpx; font-weight: bold; }
.plus { color: #07c160; }
.minus { color: #fa5151; }

.no-more {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  padding: 40rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 28rpx;
}
.empty-img { width: 240rpx; height: 240rpx; margin-bottom: 30rpx; opacity: 0.5; }